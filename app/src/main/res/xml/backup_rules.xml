<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- O banco guarda mensagens e a fila de envio. O logout apaga tudo, e o backup não pode restaurar o que ele apagou. -->
    <exclude domain="database" path="solaria.db" />
    <exclude domain="database" path="solaria.db-wal" />
    <exclude domain="database" path="solaria.db-shm" />
    <exclude domain="database" path="solaria.db-journal" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
