<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema do aplicativo. A interface é toda em Compose (core/designsystem/theme); aqui ficam o que o sistema desenha
         fora dela: janela, barras, cursor e alças de seleção de texto, e o controle ativado dos widgets nativos. -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand_primary</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="android:textColorHighlight">@color/brand_primary_container</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_500</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>
</resources>
